apiVersion: v1
kind: Secret
metadata:
  name: vibarr-secret
type: Opaque
stringData:
  POSTGRES_USER: "vibarr"
  POSTGRES_PASSWORD: "change-me-to-a-secure-database-password"
  SECRET_KEY: "change-me-to-a-secure-random-secret-key-for-production"
  DJANGO_SUPERUSER_USERNAME: "admin"
  DJANGO_SUPERUSER_EMAIL: "admin@example.com"
  DJANGO_SUPERUSER_PASSWORD: "change-me-to-a-secure-admin-password"
  TAUTULLI_URL: ""
  TAUTULLI_API_KEY: ""
